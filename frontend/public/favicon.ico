<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="hexTop" x1="12" y1="10" x2="52" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#34D399" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <linearGradient id="hexLeft" x1="12" y1="21" x2="32" y2="54" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#059669" />
      <stop offset="100%" stop-color="#064E3B" />
    </linearGradient>
    <linearGradient id="hexRight" x1="32" y1="21" x2="52" y2="54" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#10B981" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>
  </defs>

  <!-- Dark base backing -->
  <rect width="64" height="64" rx="14" fill="#070D14" />
  <rect width="64" height="64" rx="14" stroke="#10B981" stroke-width="1.5" stroke-opacity="0.3" fill="none" />

  <!-- Isometric Hexagon 3D Cube -->
  <!-- Top Face -->
  <path d="M32 10 L52 21 L32 32 L12 21 Z" fill="url(#hexTop)" stroke="#6EE7B7" stroke-width="1.5" />
  
  <!-- Left Face -->
  <path d="M12 21 L32 32 V54 L12 43 Z" fill="url(#hexLeft)" stroke="#34D399" stroke-width="1.5" />
  
  <!-- Right Face -->
  <path d="M32 32 L52 21 V43 L32 54 Z" fill="url(#hexRight)" stroke="#10B981" stroke-width="1.5" />

  <!-- Center Telemetry Micro-Core -->
  <circle cx="32" cy="32" r="3.5" fill="#F59E0B" />
  
  <!-- Telemetry Lines -->
  <line x1="32" y1="18" x2="32" y2="28" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" />
  <line x1="20" y1="39" x2="28" y2="35" stroke="#6EE7B7" stroke-width="2" stroke-linecap="round" />
  <line x1="44" y1="39" x2="36" y2="35" stroke="#6EE7B7" stroke-width="2" stroke-linecap="round" />
</svg>
